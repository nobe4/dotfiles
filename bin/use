#!/usr/bin/env bash
#/ Usage: use [PACKAGE...]
#/
#/ Start a Nix shell with given packages, or packages found from project files.
#/ Caches the nix-shell environments in $STATE_DIR
#/
#/ Flags:
#/   -h    Show this help.

set -e

show_help() {
	export STATE_DIR
	grep ^#/ <"${0}" | cut -c4- | envsubst ;
}
[[ "$*" == "-h" ]] && show_help && exit 0

# Resolve this script's real directory (following symlinks) so we always find
# the shell.nix beside it, no matter where 'use' is called from.
source="${BASH_SOURCE[0]}"
while [[ -L "$source" ]]; do
	dir="$(cd -P "$(dirname "$source")" && pwd)"
	source="$(readlink "$source")"
	[[ "$source" != /* ]] && source="$dir/$source"
done
here="$(cd -P "$(dirname "$source")" && pwd)"

exec nix-shell --impure "$here/shell.nix"
