#!/usr/bin/env bash
#/ Usage: use [PACKAGE...]
#/
#/ Start a Nix shell with given packages, or packages found from project files.
#/ Caches the nix-shell environments in $STATE_DIR
#/
#/ Flags:
#/   -h    Show this help.

set -e

STATE_DIR="${XDG_STATE_HOME:-${HOME:?}/.local/state}/use"
mkdir -p "$STATE_DIR"

show_help() {
	export STATE_DIR
	grep ^#/ <"${0}" | cut -c4- | envsubst ;
}
[[ "$*" == "-h" ]] && show_help && exit 0

# File           | content | packages
rules="
	*.rb         |         | ruby ruby-lsp
	*.go         |         | go gopls golangci-lint golangci-lint-langserver
	*.sh         |         | bash-language-server shellcheck
	*.c          |         | clang-tools
	*.lua        |         | lua-language-server
	*.md         |         | marksman
	*.nix        |         | nixd
	*.py         |         | python3 python3Packages.python-lsp-server
	*.ts         |         | nodejs typescript-language-server
	*.css        |         | vscode-langservers-extracted
	*.html       |         | vscode-langservers-extracted emmet-language-server
	*.json       |         | vscode-langservers-extracted
	*.yaml       |         | yaml-language-server
	Gemfile.lock | fiddle  | libffi pkg-config
	Gemfile.lock | trilogy | openssl pkg-config
	Gemfile.lock | mysql2  | mysql84
"

start_shell() {
	local package_key env_file profile_file tmp_file user_shell

	package_key="$(printf '%s\n' "$1" | md5sum)"
	package_key="${package_key%% *}"

	env_file="${STATE_DIR}/${package_key}.bash"
	profile_file="${STATE_DIR}/${package_key}.profile"

	if [[ ! -f "$env_file" || ! -e "$profile_file" ]]; then
		echo "[use] install: $1" >&2

		tmp_file="${env_file}.$$"

		if ! nix print-dev-env \
				--impure \
				--profile "$profile_file" \
				--expr "with import <nixpkgs> {}; mkShell { packages = [ $1 ]; }" \
				> "$tmp_file"; then
			rm -f "$tmp_file"
			return 1
		fi

		mv "$tmp_file" "$env_file"
	else
		echo "[use]  cached: $1" >&2
	fi

	# sourcing $env_file can modify $SHELL, we must save it
	user_shell="${SHELL:-bash}"

	. "$env_file"

	export SHELL="$user_shell"
	exec "$SHELL" -i
}

# If any package is specified, we just use that
if (( $# > 0 )); then
	start_shell "$*"
fi

[[ -f devenv.nix ]] && echo "[use] found devenv.nix, consider using 'devenv shell'" >&2

printf '[use]  search: ' >&2

packages=
while read -r rule; do
	[[ -z "$rule" ]] && continue

	file_pattern="${rule%% *}"
	rule="${rule#*| }"
	content_pattern="${rule%% *}"

	if [[ -z "$content_pattern" ]]; then
		rg --files -L -q -g "$file_pattern" || continue
		match="$file_pattern"
	else
		rg -q --no-messages "$content_pattern" "$file_pattern" || continue
		match="${file_pattern}:${content_pattern}"
	fi

	printf '%s ' "$match" >&2
	packages+="${rule#*| } "
done <<< "$rules"

if [[ -z "$packages" ]]; then
	printf 'no match\n' >&2
	exit 1
fi

packages="$(printf '%s' "$packages" | tr ' ' '\n' | LC_ALL=C sort -u | tr '\n' ' ')"

printf '\n' >&2

start_shell "$packages"
