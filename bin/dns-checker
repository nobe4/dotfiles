#!/usr/bin/env bash

set -e

if [ $# -eq 0 ]; then
	echo "Usage: dns-checker <domain> <query>"
	echo "   eg: dns-checker github.com CNAME"
	exit 1
fi

servers=$(cat << EOF
Global       | Cloudflare              | 1.1.1.1         |
Global       | Google                  | 8.8.8.8         |
Global       | Quad9                   | 9.9.9.9         |
Global       | OpenDNS                 | 208.67.222.222  |
Global       | AdGuard (unfiltered)    | 94.140.14.140   |
Global       | Control D (unfiltered)  | 76.76.2.0       |
Germany      | DNS.WATCH               | 84.200.69.80    |
Russia       | Yandex                  | 77.88.8.8       |
China        | AliDNS                  | 223.5.5.5       |
China        | DNSPod                  | 119.29.29.29    |
EOF
)
server_count=$(echo "$servers" | wc -l)

echo "$0 $@"
while true; do
	echo "$servers" | while IFS= read -r line ; do
		ip=$(echo "$line" | cut -d'|' -f3 | sed 's/ //g')

		# We want to split `$@`, ignore the error.
		# shellcheck disable=SC2068
		value=$(\
			dig \
			+tries=1 \
			+time=1 \
			+short \
			"@$ip" $@ \
			| paste -sd ", " - \
		)
		echo "$(date "+%S") | $line $value"
		sleep 0.2
	done

	printf "\033[%dA" "$server_count"
	sleep 0.2
done
