#!/usr/bin/env bash
set -e

[[ "$*" == "-h" ]] && cat "${0}" && exit 0

get_prs "Enter PR URL(s) to push an empty commit to:" "$@" | while read -r pr; do
	cd "$(mktemp -d)"
	echo "Pushing empty commit to PR: ${pr}"
	gh repo clone "${pr}" .
	gh pr checkout "${pr}"
	git commit --allow-empty -m 'chore: push empty commit to trigger ci'
	git push
done
