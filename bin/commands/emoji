#!/usr/bin/env bash
#/ usage: emoji [FLAGS] [QUERY]
#/
#/ Flags:
#/   -r|--refresh   Refresh the emojis list
#/   --rofi         Start a rofi window (default to fzf)

set -eo pipefail

CACHE_FILE="$(cache path emoji list)"

show_help() { grep ^#/ <"${0}" | cut -c4-; }

REFRESH=0
ROFI=0

while [ "${#}" -gt 0 ]; do
	case "${1}" in
		-h|--help) show_help && exit 0 ;;
		-r|--refresh) REFRESH=1 ;;
		--rofi) ROFI=1 ;;
		-*)
			echo "Unknown flag '${1}'"
			show_help
			exit 1
			;;

		# Break on non-flags
		*)  break ;;
	esac
	shift 1
done

refresh() {
	local tmp
	tmp="$(mktemp "${CACHE_FILE}.XXXXXX")"

	if ! curl https://unicode.org/Public/emoji/latest/emoji-test.txt |
			grep 'E\d.' |
			sed -r 's/.+# +([^ ]+) E[^ ]+ (.+)/\1 \2/' |
			grep . \
			> "${tmp}"; then
		rm -f "${tmp}"
		return 1
	fi

	mv "${tmp}" "${CACHE_FILE}"
}

if [[ "${REFRESH}" == 1 ]] || ! cache fresh emoji list; then
	echo "Refreshing emoji list at ${CACHE_FILE}" >&2
	refresh
fi


[ -f "${CACHE_FILE}" ] || exit 0

if [[ "${ROFI}" == 1 ]]; then
	selection=$(rofi -dmenu -i -p "Emoji" < "${CACHE_FILE}")
else
	selection=$(fzf --nth='2..' --query="${*}" < "${CACHE_FILE}")
fi

emoji=$(echo "${selection}" | cut -d' ' -f1)

notify "Emoji copied to clipboard" "${emoji}" -t 1000
echo "${emoji}" | copy
