#!/usr/bin/env bash
#/ Usage: git-worktree [FLAGS] [COMMAND] [ARGS]
#/
#/ Manage git worktrees of REPO (default: current dir).
#/
#/ Flags:
#/   -r|--repo REPO   Operate on REPO instead of the current dir.
#/   -p|--path        Print the full worktree path instead of the branch.
#/   -v|--verbose     Print commands as they run.
#/   -h|--help        Print this help.
#/
#/ Commands (default: list):
#/   n|new BRANCH [COMMITISH]  Add a worktree at worktree/BRANCH.
#/                             Without: reuse existing BRANCH, or pick a
#/                             base from existing worktrees. When the base
#/                             is dirty, offer to copy its diff into BRANCH.
#/   l|list [QUERY]            Pick a worktree with fzf.
#/   p|path [BRANCH]           Print the full path to worktree/BRANCH
#/   r|remove [BRANCH]         Remove worktree/BRANCH
#/   rename NEW [OLD]          Rename worktree/OLD and its branch to NEW.
#/
#/ In list:
#/   <C-n>   Add a worktree from the typed branch.
#/   <C-x>   Remove the selected worktree and branch.

set -e

show_help() { grep ^#/ <"${0}" | cut -c4- ; }

worktrees() {
	git -C "${REPO}" worktree list --porcelain 2>/dev/null \
		| while read -r key value; do
			[ "${key}" = branch ] || continue
			branch="${value#refs/heads/}"
			git -C "${REPO}" log -1 --color=always \
				--format="${branch} %Cred%h%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset" \
				"${branch}"
		done
}


print_branch() {
	if [ "${FULLPATH}" = 1 ]; then
		echo "${ROOT}/worktree/${1}"
	else
		echo "${1}"
	fi
}

new() {
	local branch="${1}"
	[ -n "${branch}" ] || { show_help >&2; exit 1; }
	local commitish="${2}"

	if [ -n "${commitish}" ]; then
		git -C "${ROOT}" worktree add -b "${branch}" "worktree/${branch}" "${commitish}" >&2
	elif git -C "${ROOT}" worktree add "worktree/${branch}" "${branch}" 2>/dev/null >&2; then
		: # Reused an existing branch.
	elif git -C "${ROOT}" fetch origin "+refs/heads/${branch}:refs/remotes/origin/${branch}" >/dev/null 2>&1; then
		git -C "${ROOT}" worktree add -b "${branch}" "worktree/${branch}" "origin/${branch}" >&2
	else
		local base
		base=$(select_branch --prompt="Base for ${branch} ")
		[ -z "${base}" ] && return

		git -C "${ROOT}" worktree add -b "${branch}" "worktree/${branch}" "${base}" >&2
		take_diff "${base}" "${branch}"
	fi

	set_upstream "${branch}"
	print_branch "${branch}"
}

copy_changes() {
	local src="${1}" dst="${2}"

	local snap
	snap="$(git -C "${src}" stash create)"
	if [ -n "${snap}" ]; then
		git -C "${dst}" stash apply "${snap}" >&2
	fi

	# stash create only snapshots tracked changes; copy untracked by hand.
	git -C "${src}" ls-files --others --exclude-standard -z \
		| while IFS= read -r -d '' f; do
			mkdir -p "${dst}/$(dirname "${f}")"
			cp -p "${src}/${f}" "${dst}/${f}"
		done
}

take_diff() {
	local base="${1}" branch="${2}"
	local src="${ROOT}/worktree/${base}"
	local dst="${ROOT}/worktree/${branch}"

	local status
	status="$(git -C "${src}" -c color.ui=always status --short)"
	[ -n "${status}" ] || return

	echo "${status}" > /dev/tty
	printf 'Take the diff from %s? [y/N] ' "${base}" > /dev/tty
	local answer
	read -r answer < /dev/tty
	case "${answer}" in
		[yY]*) copy_changes "${src}" "${dst}" ;;
	esac
}

# Track origin/BRANCH if that remote branch exists, so `git pull` just works.
set_upstream() {
	local branch="${1}"
	if git -C "${ROOT}" show-ref --verify --quiet "refs/remotes/origin/${branch}"; then
		git -C "${ROOT}" branch --set-upstream-to="origin/${branch}" "${branch}" >&2
	fi
}

remove() {
	local branch="${1:-$(select_branch --prompt="Branch to delete ")}"
	[ -z "${branch}" ] && return

	git -C "${ROOT}" worktree remove "worktree/${branch}"
	git -C "${ROOT}" branch -D "${branch}"
}

path() {
	local branch="${1:-$(select_branch --prompt="Branch path ")}"
	[ -z "${branch}" ] && return

	print_branch "${branch}"
}

rename() {
	local new="${1}"
	[ -n "${new}" ] || { show_help >&2; exit 1; }
	local old="${2:-$(select_branch --prompt="Branch to rename ")}"
	[ -z "${old}" ] && return

	git -C "${ROOT}" branch -m "${old}" "${new}"
	git -C "${ROOT}" worktree move "worktree/${old}" "worktree/${new}"

	print_branch "${new}"
}

select_branch() {
	worktrees \
		| fzf --ansi --no-preview "$@" \
		| awk '{print $1}'
}

list() {
	local branch=$(
		select_branch \
			--prompt="Branch " \
			--query="$*" \
			--bind="enter:accept-or-print-query" \
			--bind="ctrl-n:become(git-worktree --repo '${REPO}' new {q} 1>&2 ; echo {q})" \
			--bind="ctrl-x:execute(git-worktree --repo '${REPO}' remove {1})+reload(git-worktree --repo '${REPO}' list)"
	)

	[ -n "${branch}" ] || return

	if git -C "${ROOT}" worktree list --porcelain \
		| grep -Fqx "branch refs/heads/${branch}"; then
		print_branch "${branch}"
		return
	fi

	printf 'Create branch %s? [y/N] ' "${branch}" > /dev/tty
	local answer
	read -r answer < /dev/tty
	case "${answer}" in
		[yY]*) new "${branch}" ;;
	esac
}

REPO="."
FULLPATH=0

while [ "${#}" -gt 0 ]; do
	case "${1}" in
		-h|--help) show_help && exit 0 ;;
		-p|--path) FULLPATH=1 ;;
		-r|--repo) shift; REPO="${1}" ;;
		-v|--verbose) set -x ;;
		-*)
			echo "Unknown flag '${1}'"
			show_help
			exit 1
			;;
		*) break ;;
	esac
	shift 1
done

ROOT=$(git -C "${REPO}" rev-parse --path-format=absolute --git-common-dir)

[ "${#}" -eq 0 ] && { list; exit 0; }

case "${1}" in
	n|new) shift; new "$@" ;;
	l|list) shift; list "$@" ;;
	p|path) shift; path "$@" ;;
	r|remove) shift; remove "$@" ;;
	rename) shift; rename "$@" ;;
	*) list "$@" ;;
esac
