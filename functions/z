#!/usr/bin/env bash

selection=$(
	{
		git-repos
		find "${HOME}" -maxdepth 1 -mindepth 1 -type d | sed "s#^${HOME}#~#"
	} | fzf --select-1 --query "${*}"
)

[ -z "${selection}" ] && return

# no expansion of ~ is ok
# shellcheck disable=2088
case "${selection}" in
	"~/"*) cd "${selection/#\~/${HOME}}" || { echo "z: cd failed: ${selection}" >&2; return 1; } ;;
	*) cd "$(git-worktree -p --repo "${DEV_PATH}/${selection}")" || { echo "z: cd failed: ${selection}" >&2; return 1; } ;;
esac
