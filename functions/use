#!/usr/bin/env bash

local -a packages

if [[ -f devenv.nix ]]; then
	echo "use: found devenv.nix, using devenv shell" >&2
	command devenv shell "$@"
	return $?
fi

packages=("$@")

if find . -type f -name '*.rb' -print -quit | grep -q .; then
	echo "use: found Ruby files, adding ruby and ruby-lsp" >&2
	packages+=(ruby ruby-lsp)
fi

if [[ -f Gemfile ]] &&
	grep -Eq "^[[:space:]]*gem[[:space:]]+['\"]mysql2['\"]" Gemfile; then
	echo "use: found mysql2 in Gemfile, adding mysql84" >&2
	packages+=(mysql84)
fi

if find . -type f -name '*.go' -print -quit | grep -q .; then
	echo "use: found Go files, adding Go tools" >&2
	packages+=(go gopls golangci-lint golangci-lint-langserver)
fi

if find . -type f -name '*.sh' -print -quit | grep -q .; then
	echo "use: found shell files, adding Bash tools" >&2
	packages+=(bash-language-server shellcheck)
fi

if find . -type f -name '*.c' -print -quit | grep -q .; then
	echo "use: found C files, adding clang-tools" >&2
	packages+=(clang-tools)
fi

if find . -type f -name '*.lua' -print -quit | grep -q .; then
	echo "use: found Lua files, adding lua-language-server" >&2
	packages+=(lua-language-server)
fi

if find . -type f -name '*.md' -print -quit | grep -q .; then
	echo "use: found Markdown files, adding marksman" >&2
	packages+=(marksman)
fi

if find . -type f -name '*.nix' -print -quit | grep -q .; then
	echo "use: found Nix files, adding nixd" >&2
	packages+=(nixd)
fi

if find . -type f -name '*.py' -print -quit | grep -q .; then
	echo "use: found Python files, adding Python tools" >&2
	packages+=(python3 python3Packages.python-lsp-server)
fi

if find . -type f -name '*.ts' -print -quit | grep -q .; then
	echo "use: found TypeScript files, adding TypeScript tools" >&2
	packages+=(nodejs typescript-language-server)
fi

if find . -type f -name '*.css' -print -quit | grep -q .; then
	echo "use: found CSS files, adding VS Code language servers" >&2
	packages+=(vscode-langservers-extracted)
fi

if find . -type f -name '*.html' -print -quit | grep -q .; then
	echo "use: found HTML files, adding HTML tools" >&2
	packages+=(vscode-langservers-extracted emmet-language-server)
fi

if find . -type f -name '*.json' -print -quit | grep -q .; then
	echo "use: found JSON files, adding VS Code language servers" >&2
	packages+=(vscode-langservers-extracted)
fi

if find . -type f -name '*.yaml' -print -quit | grep -q .; then
	echo "use: found YAML files, adding yaml-language-server" >&2
	packages+=(yaml-language-server)
fi

packages=("${(@u)packages}")

if (( ${#packages} == 0 )); then
	echo "use: no packages given or found" >&2
	return 1
fi

command nix-shell -p "${packages[@]}"
